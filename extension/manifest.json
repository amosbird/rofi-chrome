{
    "name": "Rofi Browser Controller",
    "key": "",
    "version": "1.4.0",
    "description": "Control Chromium tabs, history, downloads, and bookmarks through Rofi.",
    "manifest_version": 3,
    "permissions": [
        "nativeMessaging",
        "tabs",
        "history",
        "downloads",
        "offscreen",
        "clipboardWrite",
        "scripting",
        "activeTab"
    ],
    "optional_permissions": [
        "bookmarks"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Rofi Browser Controller",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "background": {
        "service_worker": "bg.js"
    },
    "commands": {
        "switchTab": {
            "description": "Switch to another tab"
        },
        "listDownloads": {
            "description": "List completed downloads"
        },
        "openHistory": {
            "description": "Open a page from browsing history"
        },
        "pageFunc": {
            "description": "Search history from the current site"
        },
        "goLastTab": {
            "description": "Return to the previously active tab"
        },
        "scrollToTop": {
            "suggested_key": {
                "default": "Alt+Shift+Home"
            },
            "description": "Scroll the current page to the beginning"
        },
        "scrollToBottom": {
            "suggested_key": {
                "default": "Alt+Shift+End"
            },
            "description": "Scroll the current page to the end"
        }
    }
}
